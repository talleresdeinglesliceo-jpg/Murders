local RoleColors = {
	Murder = Color3.fromRGB(235, 64, 52),
	Sheriff = Color3.fromRGB(52, 134, 235),
	Innocent = Color3.fromRGB(52, 199, 89)
}

local RoleLabels = {
	Murder = "MURDER",
	Sheriff = "SHERIFF",
	Innocent = "INOCENTE"
}

local function clearESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then
			local hl = plr.Character:FindFirstChild("FamilyRoleESP")
			if hl then hl:Destroy() end
			local tag = plr.Character:FindFirstChild("FamilyRoleTag")
			if tag then tag:Destroy() end
		end
	end
end

local function getRoleType(plr)
	local backpack = plr:FindFirstChild("Backpack")
	local char = plr.Character
	local function hasTool(container, keyword)
		if not container then return false end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and string.find(string.lower(item.Name), keyword) then
				return true
			end
		end
		return false
	end
	if hasTool(char, "knife") or hasTool(backpack, "knife") then
		return "Murder"
	elseif hasTool(char, "gun") or hasTool(backpack, "gun") or hasTool(char, "revolver") or hasTool(backpack, "revolver") then
		return "Sheriff"
	end
	return "Innocent"
end

local function isGunTool(obj)
	if not obj or not obj:IsA("Tool") then return false end
	local n = string.lower(obj.Name)
	return string.find(n, "gun") ~= nil or string.find(n, "revolver") ~= nil or string.find(n, "pistol") ~= nil
end

local function isKnifeTool(obj)
	if not obj or not obj:IsA("Tool") then return false end
	return string.find(string.lower(obj.Name), "knife") ~= nil
end

local function getEquippedOrOwnedGun()
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if isGunTool(child) then return child end
		end
	end
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if isGunTool(child) then return child end
		end
	end
	return nil
end

local function getEquippedOrOwnedKnife()
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if isKnifeTool(child) then return child end
		end
	end
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if isKnifeTool(child) then return child end
		end
	end
	return nil
end

local function hasGunEquippedOrOwned()
	return getEquippedOrOwnedGun() ~= nil
end

local function getMurderTorsoPart()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and getRoleType(plr) == "Murder" then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if char and hum and hum.Health > 0 then
				local torso = char:FindFirstChild("HumanoidRootPart")
					or char:FindFirstChild("UpperTorso")
					or char:FindFirstChild("Torso")
				if torso and torso:IsA("BasePart") then
					return torso, plr, char
				end
			end
		end
	end
	return nil, nil, nil
end

local function isPartVisibleFromCamera(targetPart, targetChar)
	if not Camera or not targetPart then return false end
	local origin = Camera.CFrame.Position
	local delta = targetPart.Position - origin
	local distance = delta.Magnitude
	if distance <= 0.1 then return true end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList = {}
	if LocalPlayer.Character then
		table.insert(ignoreList, LocalPlayer.Character)
	end
	if targetChar then
		table.insert(ignoreList, targetChar)
	end
	rayParams.FilterDescendantsInstances = ignoreList

	local result = Workspace:Raycast(origin, delta.Unit * distance, rayParams)
	return result == nil
end

local function getAliveTargetsInMatch()
	local targets = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if char and hum and hum.Health > 0 and root then
				table.insert(targets, { player = plr, char = char, hum = hum, root = root })
			end
		end
	end
	return targets
end

local autoKillIndex = 1
local lastAutoKillStep = 0

local function runAutoKillStep(myChar, myHum, myRoot)
	if not State.AutoKillEnabled or not myChar or not myHum or not myRoot or myHum.Health <= 0 then
		return
	end
	local now = os.clock()
	if (now - lastAutoKillStep) < 0.16 then
		return
	end

	local equippedTool = myChar:FindFirstChildOfClass("Tool")
	local gunTool = getEquippedOrOwnedGun()
	local knifeTool = getEquippedOrOwnedKnife()

	if gunTool then
		if equippedTool ~= gunTool and not equippedTool then
			pcall(function() myHum:EquipTool(gunTool) end)
		end
		local murderTorso = getMurderTorsoPart()
		if murderTorso then
			lastAutoKillStep = now
			pcall(function()
				myRoot.CFrame = murderTorso.CFrame * CFrame.new(0, 0, 3.8)
			end)
		end
		return
	end

	if knifeTool then
		if equippedTool ~= knifeTool and not equippedTool then
			pcall(function() myHum:EquipTool(knifeTool) end)
		end
		local targets = getAliveTargetsInMatch()
		if #targets > 0 then
			if autoKillIndex > #targets then
				autoKillIndex = 1
			end
			local chosen = targets[autoKillIndex]
			autoKillIndex += 1
			if chosen and chosen.root then
				lastAutoKillStep = now
				pcall(function()
					myRoot.CFrame = chosen.root.CFrame * CFrame.new(0, 0, 3.2)
				end)
			end
		end
	end
end

local function getSilentAimTorsoPosition()
	if not State.AutoShotMurder then return nil end
	if (State.SilentAimAccuracy or 100) < 100 then return nil end
	if not hasGunEquippedOrOwned() then return nil end
	local torso = getMurderTorsoPart()
	if torso then
		return torso.Position, torso
	end
	return nil
end

pcall(function()
	if typeof(hookmetamethod) == "function" then
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			local method = getnamecallmethod()
			if self == Workspace and (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") then
				local targetPos = getSilentAimTorsoPosition()
				if targetPos then
					local args = { ... }
					if method == "Raycast" and typeof(args[1]) == "Vector3" then
						args[2] = (targetPos - args[1]).Unit * 500
						return oldNamecall(self, unpack(args))
					elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and typeof(args[1]) == "Ray" then
						local origin = args[1].Origin
						args[1] = Ray.new(origin, (targetPos - origin).Unit * 500)
						return oldNamecall(self, unpack(args))
					end
				end
			end
			return oldNamecall(self, ...)
		end)
	end
end)

local function ensureRoleTag(plr, char, role, color)
	local anchor = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if not anchor or not anchor:IsA("BasePart") then return end

	local bbg = char:FindFirstChild("FamilyRoleTag")
	if not bbg then
		bbg = Instance.new("BillboardGui")
		bbg.Name = "FamilyRoleTag"
		bbg.Size = UDim2.new(0, 170, 0, 34)
		bbg.StudsOffset = Vector3.new(0, 2.7, 0)
		bbg.AlwaysOnTop = true
		bbg.MaxDistance = 1000
		bbg.Parent = char

		local lbl = Instance.new("TextLabel")
		lbl.Name = "TagLabel"
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 13
		lbl.TextStrokeTransparency = 0.2
		lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		lbl.Parent = bbg
	end

	bbg.Adornee = anchor
	local lbl = bbg:FindFirstChild("TagLabel")
	if lbl and lbl:IsA("TextLabel") then
		lbl.Text = "[" .. (RoleLabels[role] or "INOCENTE") .. "] " .. plr.DisplayName
		lbl.TextColor3 = color
	end
end

local function updateESPRoles()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local existingHl = plr.Character:FindFirstChild("FamilyRoleESP")
			local existingTag = plr.Character:FindFirstChild("FamilyRoleTag")
			if State.ESPRoles then
				local role = getRoleType(plr)
				local color = RoleColors[role] or RoleColors.Innocent

				local hl = existingHl or Instance.new("Highlight")
				hl.Name = "FamilyRoleESP"
				hl.Adornee = plr.Character
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.FillColor = color
				hl.OutlineColor = Color3.fromRGB(255, 255, 255)
				hl.FillTransparency = 0.42
				hl.OutlineTransparency = 0
				hl.Parent = plr.Character

				ensureRoleTag(plr, plr.Character, role, color)
			else
				if existingHl then existingHl:Destroy() end
				if existingTag then existingTag:Destroy() end
			end
		end
	end
end

