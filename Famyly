local function applySkyboxByName(skyName)
	local preset = SkyboxMap[skyName] or SkyboxPresets[1]
	State.SkyboxName = preset.Name

	pcall(function()
		if not managedSky or not managedSky.Parent then
			managedSky = Lighting:FindFirstChild("FamilyHUDSky") or Instance.new("Sky")
			managedSky.Name = "FamilyHUDSky"
			managedSky.Parent = Lighting
		end

		if preset.Name == "Default Sky" and OriginalSkySnapshot then
			managedSky.StarCount = OriginalSkySnapshot.StarCount
			managedSky.SunAngularSize = OriginalSkySnapshot.SunAngularSize
			managedSky.MoonAngularSize = OriginalSkySnapshot.MoonAngularSize
			managedSky.SkyboxFt = OriginalSkySnapshot.Ft
			managedSky.SkyboxBk = OriginalSkySnapshot.Bk
			managedSky.SkyboxLf = OriginalSkySnapshot.Lf
			managedSky.SkyboxRt = OriginalSkySnapshot.Rt
			managedSky.SkyboxUp = OriginalSkySnapshot.Up
			managedSky.SkyboxDn = OriginalSkySnapshot.Dn
		else
			managedSky.StarCount = preset.StarCount
			managedSky.SunAngularSize = preset.SunAngularSize
			managedSky.MoonAngularSize = preset.MoonAngularSize
			managedSky.SkyboxFt = preset.Ft
			managedSky.SkyboxBk = preset.Bk
			managedSky.SkyboxLf = preset.Lf
			managedSky.SkyboxRt = preset.Rt
			managedSky.SkyboxUp = preset.Up
			managedSky.SkyboxDn = preset.Dn
		end

		for _, obj in ipairs(Lighting:GetChildren()) do
			if obj:IsA("Sky") and obj ~= managedSky then
				obj:Destroy()
			end
		end
	end)
end

local lastSkyGuard = 0
Lighting.ChildAdded:Connect(function(child)
	if child:IsA("Sky") and child ~= managedSky then
		local now = os.clock()
		if (now - lastSkyGuard) >= 0.2 then
			lastSkyGuard = now
			task.defer(function()
				applySkyboxByName(State.SkyboxName)
			end)
		end
	end
end)

local function applyFPSBoost(enabled)
	State.FPSBoost = enabled
	pcall(function()
		if enabled then
			Lighting.GlobalShadows = false
			Lighting.EnvironmentSpecularScale = 0
			Lighting.EnvironmentDiffuseScale = 0
			if settings and settings():FindFirstChild("Rendering") then
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			end
		else
			Lighting.GlobalShadows = LightingBackup.GlobalShadows
			Lighting.EnvironmentSpecularScale = LightingBackup.EnvironmentSpecularScale
			Lighting.EnvironmentDiffuseScale = LightingBackup.EnvironmentDiffuseScale
			if settings and settings():FindFirstChild("Rendering") then
				settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
			end
		end
	end)
end

