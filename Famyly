local function createFloatingToggleButton(name, labelText, defaultPos, isActiveFn, onTap)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(0, 118, 0, 38)
	btn.Position = defaultPos
	btn.Text = labelText
	btn.TextSize = 11
	btn.Font = Enum.Font.GothamBold
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.AutoButtonColor = false
	btn.Visible = false
	btn.ZIndex = 20
	btn.Parent = ScreenGui
	addCorner(btn, 19)
	addIOSPressEffect(btn, 0.93)
	attachRainbowBorder(btn, 1.5)

	local function refreshActiveVisual(active)
		btn.Text = labelText .. (active and ": ON" or ": OFF")
		TweenService:Create(btn, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = active and Theme.ToggleOnBg or Theme.CardBg
		}):Play()
	end

	refreshActiveVisual(isActiveFn())
	makeDraggable(btn, btn)

	btn.MouseButton1Click:Connect(function()
		onTap()
		refreshActiveVisual(isActiveFn())
	end)

	return btn, refreshActiveVisual
end

