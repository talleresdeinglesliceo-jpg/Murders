local function performServerHop()
	configStatusLbl.Text = "Estado: Buscando otro servidor..."
	local placeId = game.PlaceId
	local currentJobId = game.JobId
	local targetServerId = nil

	pcall(function()
		local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", placeId)
		local raw = game:HttpGet(url)
		local decoded = HttpService:JSONDecode(raw)
		if decoded and type(decoded.data) == "table" then
			local candidates = {}
			for _, srv in ipairs(decoded.data) do
				if type(srv) == "table" and srv.id and tostring(srv.id) ~= tostring(currentJobId) then
					local playing = tonumber(srv.playing) or 0
					local maxPlayers = tonumber(srv.maxPlayers) or 0
					if maxPlayers > 0 and playing < maxPlayers then
						table.insert(candidates, tostring(srv.id))
					end
				end
			end
			if #candidates > 0 then
				targetServerId = candidates[math.random(1, #candidates)]
			end
		end
	end)

	local ok, err = pcall(function()
		if targetServerId then
			TeleportService:TeleportToPlaceInstance(placeId, targetServerId, LocalPlayer)
		else
			TeleportService:Teleport(placeId, LocalPlayer)
		end
	end)

	if not ok then
		configStatusLbl.Text = "Server Hop error: " .. tostring(err)
	end
end

