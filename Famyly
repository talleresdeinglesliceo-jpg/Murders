local flyAttachment = nil
local flyLinearVel = nil

local function clearFlyPhysics()
	if flyLinearVel then
		pcall(function() flyLinearVel:Destroy() end)
		flyLinearVel = nil
	end
	if flyAttachment then
		pcall(function() flyAttachment:Destroy() end)
		flyAttachment = nil
	end
end

local function ensureFlyPhysics(root, hum)
	if not root or not root:IsA("BasePart") then return nil end
	if hum and hum.PlatformStand ~= true then
		pcall(function() hum.PlatformStand = true end)
	end
	if not flyAttachment or not flyAttachment.Parent then
		flyAttachment = Instance.new("Attachment")
		flyAttachment.Name = "FamilyFlyAttachment"
		flyAttachment.Parent = root
	end
	if not flyLinearVel or not flyLinearVel.Parent then
		flyLinearVel = Instance.new("LinearVelocity")
		flyLinearVel.Name = "FamilyFlyVelocity"
		flyLinearVel.Attachment0 = flyAttachment
		flyLinearVel.ForceLimitMode = Enum.ForceLimitMode.Magnitude
		flyLinearVel.MaxForce = 1e6
		flyLinearVel.VectorVelocity = Vector3.zero
		flyLinearVel.Parent = root
	end
	return flyLinearVel
end

local function setFlyState(enabled)
	State.FlyEnabled = enabled
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if enabled then
		if root and hum then
			ensureFlyPhysics(root, hum)
		end
	else
		clearFlyPhysics()
		if hum and hum.PlatformStand then
			pcall(function() hum.PlatformStand = false end)
		end
	end
	if Ctrl.FloatFlyVisual then
		Ctrl.FloatFlyVisual(enabled)
	end
end

local OriginalCanCollide = setmetatable({}, { __mode = "k" })

local function applyNoclipStep(char)
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if OriginalCanCollide[part] == nil then
				OriginalCanCollide[part] = part.CanCollide
			end
			if part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end

local function restoreNoclip(char)
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and OriginalCanCollide[part] ~= nil then
			part.CanCollide = OriginalCanCollide[part]
			OriginalCanCollide[part] = nil
		end
	end
end

local function setNoclipState(enabled)
	State.Noclip = enabled
	if enabled then
		applyNoclipStep(LocalPlayer.Character)
	else
		restoreNoclip(LocalPlayer.Character)
	end
	if Ctrl.FloatNoclipVisual then
		Ctrl.FloatNoclipVisual(enabled)
	end
end

