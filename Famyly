local function createSliderCard(parent, title, minVal, maxVal, initialVal, decimals, onChanged)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 50)
	card.BorderSizePixel = 0
	card.Parent = parent
	addCorner(card, 12)
	addStroke(card, "Border", 1)
	registerColor(card, "BackgroundColor3", "CardBg")

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(0, 165, 1, 0)
	titleLbl.Position = UDim2.new(0, 14, 0, 0)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = title
	titleLbl.TextSize = 13
	titleLbl.Font = Enum.Font.GothamMedium
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = card
	registerColor(titleLbl, "TextColor3", "TextPrimary")

	local function formatValue(v)
		if decimals and decimals > 0 then
			return string.format("%." .. tostring(decimals) .. "f", v)
		end
		return tostring(math.floor(v + 0.5))
	end

	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(0, 44, 1, 0)
	valLbl.Position = UDim2.new(1, -182, 0, 0)
	valLbl.BackgroundTransparency = 1
	valLbl.Text = formatValue(initialVal)
	valLbl.TextSize = 12
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.Parent = card
	registerColor(valLbl, "TextColor3", "TextSecondary")

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0, 118, 0, 6)
	track.Position = UDim2.new(1, -130, 0.5, -3)
	track.BorderSizePixel = 0
	track.Parent = card
	addCorner(track, 3)
	registerColor(track, "BackgroundColor3", "SliderTrack")

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BorderSizePixel = 0
	fill.Parent = track
	addCorner(fill, 3)
	registerColor(fill, "BackgroundColor3", "SliderFill")

	local thumb = Instance.new("TextButton")
	thumb.Size = UDim2.new(0, 16, 0, 16)
	thumb.Position = UDim2.new(0, -8, 0.5, -8)
	thumb.Text = ""
	thumb.AutoButtonColor = false
	thumb.Parent = track
	addCorner(thumb, 8)
	registerColor(thumb, "BackgroundColor3", "KnobColor")

	local currentVal = initialVal
	local sliding = false

	local function setValue(raw, fireCallback)
		raw = math.clamp(raw, minVal, maxVal)
		if not decimals or decimals == 0 then
			raw = math.floor(raw + 0.5)
		else
			local mult = 10 ^ decimals
			raw = math.floor(raw * mult + 0.5) / mult
		end
		currentVal = raw
		local realAlpha = (currentVal - minVal) / (maxVal - minVal)
		fill.Size = UDim2.new(realAlpha, 0, 1, 0)
		thumb.Position = UDim2.new(realAlpha, -8, 0.5, -8)
		valLbl.Text = formatValue(currentVal)
		if fireCallback and onChanged then
			onChanged(currentVal)
		end
	end

	setValue(initialVal, false)

	local function updateFromInput(inputPos)
		local absX = track.AbsolutePosition.X
		local absW = track.AbsoluteSize.X
		if absW > 0 then
			local alpha = math.clamp((inputPos.X - absX) / absW, 0, 1)
			setValue(minVal + (maxVal - minVal) * alpha, true)
		end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateFromInput(input.Position)
		end
	end)

	thumb.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input.Position)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	local api = {
		setValue = function(v, fireCallback)
			setValue(v, fireCallback)
		end
	}
	table.insert(DynamicControls, api)
	return card, api
end

