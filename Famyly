local RainbowStrokes = {}

local function attachRainbowBorder(targetInstance, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = thickness or 1.6
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = targetInstance

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 59, 92)),
		ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 165, 0)),
		ColorSequenceKeypoint.new(0.40, Color3.fromRGB(52, 211, 153)),
		ColorSequenceKeypoint.new(0.60, Color3.fromRGB(56, 189, 248)),
		ColorSequenceKeypoint.new(0.80, Color3.fromRGB(168, 85, 247)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 59, 92))
	})
	grad.Parent = stroke

	table.insert(RainbowStrokes, { stroke = stroke, gradient = grad })
	return stroke, grad
end

local function registerColor(inst, prop, role)
	if not inst or not role or not Theme[role] then return end
	if not UIRegistry[role] then
		UIRegistry[role] = {}
	end
	table.insert(UIRegistry[role], { obj = inst, prop = prop })
	inst[prop] = Theme[role]
end

local function addCorner(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	corner.Parent = instance
	return corner
end

local function addStroke(instance, role, thickness)
	local stroke = Instance.new("UIStroke")
	local r = UIRegistry[role] and role or "Border"
	stroke.Color = Theme[r]
	stroke.Thickness = thickness or 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
	registerColor(stroke, "Color", r)
	return stroke
end

local function addIOSPressEffect(btn, scaleAmount)
	local pressScale = scaleAmount or 0.96
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1
	uiScale.Parent = btn

	btn.MouseButton1Down:Connect(function()
		TweenService:Create(uiScale, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = pressScale
		}):Play()
	end)

	local function release()
		TweenService:Create(uiScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1
		}):Play()
	end

	btn.MouseButton1Up:Connect(release)
	btn.MouseLeave:Connect(release)
end

local function makeDraggable(dragHandle, targetFrame, onMoved)
	local dragging = false
	local dragStart, startPos

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = targetFrame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			targetFrame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
			if onMoved then onMoved(targetFrame.Position) end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local DynamicControls = {}
local ActiveTabName = "Home"
local Tabs = {}
local TabButtons = {}
local TabAccents = {}

local function selectTab(name)
	ActiveTabName = name
	for tabName, p in pairs(Tabs) do
		local active = (tabName == name)
		p.Visible = active
		local btn = TabButtons[tabName]
		local bar = TabAccents[tabName]
		if btn then
			TweenService:Create(btn, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = active and 0 or 1,
				BackgroundColor3 = active and Theme.ActiveTabBg or Theme.SidebarBg,
				TextColor3 = active and Theme.TextPrimary or Theme.TextSecondary
			}):Play()
		end
		if bar then
			bar.Visible = active
			bar.BackgroundColor3 = Theme.AccentBtn
		end
	end
end

local function applyTheme(themeIndex)
	themeIndex = math.clamp(themeIndex or 1, 1, #Themes)
	State.ThemeIndex = themeIndex
	local chosen = Themes[themeIndex]
	for k, v in pairs(chosen) do
		Theme[k] = v
	end

	for role, entries in pairs(UIRegistry) do
		local targetColor = Theme[role]
		if targetColor then
			for _, entry in ipairs(entries) do
				if entry.obj and entry.obj.Parent then
					pcall(function()
						entry.obj[entry.prop] = targetColor
					end)
				end
			end
		end
	end

	selectTab(ActiveTabName)

	for _, ctrl in ipairs(DynamicControls) do
		if ctrl.refreshTheme then
			pcall(ctrl.refreshTheme)
		end
	end
end

