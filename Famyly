-- Caché de monedas para evitar escaneos pesados cada frame
local cachedCoins = {}
local lastCoinScan = 0
local lastEspUpdate = 0

local function refreshCoinCache()
	local list = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and (string.lower(obj.Name) == "coin_server" or string.find(string.lower(obj.Name), "coin")) then
			table.insert(list, obj)
		end
	end
	cachedCoins = list
end

-- Loop principal optimizado
local frameCounter = 0
local elapsedStats = 0
local currentFPS = 60
local rainbowRotation = 0

RunService.RenderStepped:Connect(function(dt)
	rainbowRotation = (rainbowRotation + dt * 95) % 360
	for _, rb in ipairs(RainbowStrokes) do
		if rb.gradient and rb.gradient.Parent then
			rb.gradient.Rotation = rainbowRotation
		end
	end

	frameCounter += 1
	elapsedStats += dt
	if elapsedStats >= 0.35 then
		currentFPS = math.floor((frameCounter / elapsedStats) + 0.5)
		local pingMs = getCurrentPingMs()
		frameCounter = 0
		elapsedStats = 0
		if fpsLbl and fpsLbl.Parent then
			fpsLbl.Text = "FPS: " .. tostring(currentFPS)
		end
		if msLbl and msLbl.Parent then
			msLbl.Text = "MS: " .. tostring(pingMs) .. " ms"
		end
	end

	local now = os.clock()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if hum and State.SpeedEnabled and hum.WalkSpeed ~= State.CustomSpeed then
		hum.WalkSpeed = State.CustomSpeed
	end

	if root and hum and State.FlyEnabled then
		local lv = ensureFlyPhysics(root, hum)
		if lv then
			local moveDir = hum.MoveDirection or Vector3.zero
			local vertical = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical += 1 end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical -= 1 end
			lv.VectorVelocity = Vector3.new(
				moveDir.X * State.FlySpeed,
				vertical * State.FlySpeed,
				moveDir.Z * State.FlySpeed
			)
		end
	elseif flyLinearVel then
		clearFlyPhysics()
	end

	if State.AutoGrabGun and root then
		local gunDrop = Workspace:FindFirstChild("GunDrop", true)
		if gunDrop and gunDrop:IsA("BasePart") then
			safeTouch(gunDrop, root)
		end
	end

	if State.FarmCoins and root then
		if (now - lastCoinScan) >= 1.5 or #cachedCoins == 0 then
			lastCoinScan = now
			refreshCoinCache()
		end
		for i = #cachedCoins, 1, -1 do
			local coinPart = cachedCoins[i]
			if coinPart and coinPart.Parent then
				if (coinPart.Position - root.Position).Magnitude <= 35 then
					safeTouch(coinPart, root)
				end
			else
				table.remove(cachedCoins, i)
			end
		end
	end

	if State.AutoKillEnabled and char and hum and root then
		runAutoKillStep(char, hum, root)
	end

	if State.CamLockEnabled and Camera and root then
		if hasGunEquippedOrOwned() then
			local torsoPart, _, murderChar = getMurderTorsoPart()
			if torsoPart and isPartVisibleFromCamera(torsoPart, murderChar) then
				pcall(function()
					Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, torsoPart.Position)
				end)
			end
		end
	end

	if State.AutoVoteMap and root then
		local chosenMap = string.lower(MapsList[State.SelectedMapIndex] or "")
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and string.find(string.lower(obj.Name), chosenMap) then
				root.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
				break
			end
		end
	end

	if State.ESPRoles and (now - lastEspUpdate) >= 0.20 then
		lastEspUpdate = now
		pcall(updateESPRoles)
	end

	if State.HitboxExpander and hitboxDirty then
		pcall(updateHitboxes)
	end
end)
